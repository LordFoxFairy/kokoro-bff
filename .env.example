# Root shared local PostgreSQL/Redis; BFF owns its PostgreSQL database and
# uses Redis logical DB 8 for cache, coordination, and notifications.
NODE_ENV=development
KOKORO_BFF_HOST=127.0.0.1
KOKORO_BFF_PORT=4300
KOKORO_BFF_MODE=mock
KOKORO_DOMAIN=dev.kokoro.localhost
KOKORO_TENANT_ID=tenant_local

# Server-only service credentials; replace these fixture values locally.
KOKORO_BFF_SHARED_SECRET=TOKEN
KOKORO_INTERNAL_SECRET_BFF=TOKEN

KOKORO_BFF_POSTGRES_URL=postgresql://kokoro:kokoro@127.0.0.1:55433/kokoro_worker_bff
KOKORO_BFF_REDIS_URL=redis://127.0.0.1:56380/8

# Real PostgreSQL/Redis integration tests use the same owner-isolated pair.
KOKORO_TEST_POSTGRES_URL=postgresql://kokoro:kokoro@127.0.0.1:55433/kokoro_worker_bff
KOKORO_TEST_REDIS_URL=redis://127.0.0.1:56380/8
