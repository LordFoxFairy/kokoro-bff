  "authentication": {
    "profile": "platform-bff-service-auth",
    "surface": "mcp_personal",
    "caller": "kokoro-bff",
    "trusted_context": "current tenant credential and trusted subject; BFF verifies fresh human MCP action and every canonical project",
    "unchanged_profile_sha256": "4a6db18267a2a61e2b3582ece3a8bfae391db58280f06397125332ccaa97f0ef"
  },
  "methods": [
    {
      "method": "PublishMcpUrlToProjects",
      "command": true
    },
    {
      "method": "ListProjectMcpPins",
      "command": false
    },
    {
      "method": "RemoveProjectMcpPin",
      "command": true
    },
    {
      "method": "GetMcpProjectPublicationReceipt",
      "command": false
    }
  ],
  "limits": {
    "id_pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$",
    "source_and_pin_version_max": 2147483647,
    "targets_min": 1,
    "targets_max": 32,
    "list_default": 50,
    "list_max": 100,
    "cursor_max": 2048,
    "body_bytes": 65536,
    "total_budget_ms": 10000
  },
  "semantics": {
    "publication": "definition and project pin only; no shared secret/Connection/authorization/execution grant",
    "runtime_revision_binding": "not implemented in this slice",
    "execution_ready": "required presence and false",
    "snapshot": "independent immutable URL revision ID/content digest; source CAS only a precondition",
    "expected_pin": "absent=true requires no row, tombstone requires current CAS",
    "pin_change": "new successful command advances current pin +1, even same definition; original replay preserves original ACK",
    "remove": "new command on tombstone rejected; original successful key replayed",
    "receipt_missing": "not confirmed, never evidence of not sent",
    "digest": "sha256 UTF8 JSON.stringify fixed tuple; ordered target array sorted ASCII project_id; requestId/key excluded",
    "publish_tuple": [
      "mcp-project-publication/v1",
      "tenant_id",
      "subject_id",
      "mcp.url.publish_projects",
      "server_id",
      "connector_id",
      "source_state_version:number",
      "sorted [[project_id, null | [pin_id,state_version:number]]]"
    ],
    "remove_tuple": [
      "mcp-project-publication/v1",
      "tenant_id",
      "subject_id",
      "mcp.project_pin.remove",
      "project_id",
      "pin_id",
      "state_version:number"
    ]
  },
