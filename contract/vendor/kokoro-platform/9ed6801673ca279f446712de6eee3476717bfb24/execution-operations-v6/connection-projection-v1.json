{
  "version": "mcp-self-connection-projection/1.0.0",
  "httpVersion": "3.2.0",
  "method": "GET",
  "path": "/v1/mcp/connections",
  "visibility": "internal-owner",
  "surface": "mcp-connection",
  "identity": [
    "IAM tenant",
    "authenticated BFF workload",
    "trusted Product Session subject",
    "user/self"
  ],
  "permission": "platform:projection.read",
  "humanPermissionAdded": false,
  "executionGrant": false,
  "requiredFields": [
    "connection_id",
    "connector_id",
    "server_id",
    "provider_key",
    "transport",
    "status"
  ],
  "query": {
    "connection_id": {
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
    },
    "provider_key": {
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "limit": {
      "required": false,
      "type": "integer",
      "default": 50,
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "required": false,
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "cursor": {
    "surface": "mcp-self-connections",
    "binding": [
      "tenant",
      "subject",
      "connection_id presence/value",
      "provider_key presence/value"
    ],
    "order": ["server_id", "connection_id"]
  },
  "eligibility": [
    "same-tenant active connection",
    "same-tenant active user/self connector",
    "current same-tenant same-connector approved authorization",
    "registered streamable_http server with matching provider"
  ],
  "scan": {
    "batchSize": 100,
    "maxBatches": 10,
    "maxCandidates": 1000,
    "maxQueries": 40,
    "isolation": "RepeatableRead",
    "transactionMs": 2000,
    "softMs": 1000,
    "overflow": "503 capability.dependencies_unavailable",
    "partialSuccess": false
  },
  "writes": false,
  "providerCalls": false,
  "secretCalls": false
}
