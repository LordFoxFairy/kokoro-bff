  "profile": "mcp-private-server-v2",
  "version": "2.0.0",
  "owner": "Platform/MCP",
  "visibility": "internal-owner",
  "normal_activation": false,
  "service": "kokoro.platform.v1.ProductMcpPersonalService",
  "methods": [
    {
      "name": "RegisterPersonalMcpServer",
      "command": true
    },
    {
      "name": "ImportPersonalMcpJson",
      "command": true
    },
    {
      "name": "GetPersonalMcpServer",
      "command": false
    },
    {
      "name": "PreparePersonalMcpServer",
      "command": true
    },
    {
      "name": "UpdatePersonalMcpServer",
      "command": true
    },
    {
      "name": "DeletePersonalMcpServer",
      "command": true
    },
    {
      "name": "GetPersonalMcpPrepareReceipt",
      "command": false
    },
    {
      "name": "ReauthorizePersonalMcpServer",
      "command": true
    }
  ],
  "request": {
    "fields": {
      "request_id": 1,
      "command": 2,
      "server_id": 3,
      "source_connector_id": 4,
      "expected_server_state_version": 5,
      "expected_connector_state_version": 6
    },
    "state_version": {
      "minimum": 1,
      "maximum": 2147483646
    },
    "identity": "fresh trusted workload tenant and human subject; never request supplied"
  },
  "semantics": {
    "save": "one current private configuration per canonical URL; no connection created",
    "remove": "permanent old connector revocation; configuration remains manageable",
    "reauthorize": "explicit owner personal_remove only; double CAS; new connector and later new connection; no external call",
    "delete": "private disabled/current NULL tombstone; remove all configuration secrets; preserve permanent safety identities",
    "receipts": "fresh identity and original safety binding first; completed safe ACK survives later Delete; expired never reexecutes; unknown retains original key/body",
    "execution": "current binding plus original runtime eligibility; management visibility never grants execution",
    "global": "currentConnectorId is always NULL; ordinary Provider behavior unchanged",
    "migration": "exact unique existing owner binding or whole transaction fails; never choose latest row"
  },
