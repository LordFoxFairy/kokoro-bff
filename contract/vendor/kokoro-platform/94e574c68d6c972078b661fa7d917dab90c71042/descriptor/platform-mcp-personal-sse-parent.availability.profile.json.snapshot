{
  "profile": "mcp-local-availability-v1",
  "version": "1.0.0",
  "owner": "Platform/MCP",
  "visibility": "internal-owner",
  "status": "prepared",
  "runtime_verified": false,
  "http_version": "6.2.0",
  "enum": {
    "UNSPECIFIED": 0,
    "AVAILABLE": 1,
    "REFRESH_REQUIRED": 2,
    "REFRESHING": 3,
    "REAUTHORIZATION_REQUIRED": 4,
    "UNAVAILABLE": 5
  },
  "response_fields": {
    "PersonalMcpConnector": 13,
    "PersonalMcpServer": 15
  },
  "json_values": [
    "available",
    "refresh_required",
    "refreshing",
    "reauthorization_required",
    "unavailable"
  ],
  "semantics": {
    "zero": "invalid output; never infer available from missing, default or unknown",
    "read": "same bounded owner snapshot and database observation; no remote I/O or mutation",
    "meaning": "local qualification only, not network liveness or execution permission",
    "receipt": "business ACK remains historical; every current response reprojects availability instead of storing it in the receipt",
    "global_oauth": "unavailable until a formal global runtime-material reader exists"
  },
  "affected_oauth_responses": [
    "BeginPersonalMcpConnectorAuthorizationResponse.connector",
    "CompletePersonalMcpConnectorAuthorizationResponse.connector",
    "ReconnectPersonalMcpConnectorAuthorizationResponse.connector"
  ],
  "historical_oauth_profile": "mcp-personal-oauth-v1 1.0.0 remains its original frozen CUSTOM_API parent graph; this successor covers its embedded connector delta",
