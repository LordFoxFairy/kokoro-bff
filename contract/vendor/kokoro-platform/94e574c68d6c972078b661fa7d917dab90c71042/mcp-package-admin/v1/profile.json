      "workload_surface": "mcp_admin",
      "credential_purpose": "mcp_admin",
      "command": true
    }
  ],
  "semantics": {
    "identity": "tenant from current workload admission; subject from trusted BFF metadata; BFF separately requires current human platform-admin",
    "body_identity": "forbidden",
    "upload_owner": "Storage mcp_package scope; capability_package purpose; independent Platform service credential",
    "upload_command_identity": "derived from operation/tenant/subject/package/raw-command-key; same raw key in another scope is a different Storage command",
    "upload_receipt": "Storage only; same-command retry or status read after unknown result; Begin replay rechecks eligibility and re-signs PUT",
    "publish_receipt": "Platform tenant/command identity, full trusted subject/provider/source digest; atomic profile/Server/outbox/completed receipt",
    "source_version": "Storage staging source object version, not runtime version",
    "digest": "SHA256 UTF8 JSON.stringify fixed string tuple; exact vectors; request_id and command_id excluded",
    "input": "reject unknown/duplicate/alias JSON and protobuf unknown fields before IAM or Storage",
    "qualification": "fresh exact completed metadata and current scan; upload completed is not CLEAN, published is not runtime admission",
    "signed_material": "transient no-store PUT only; no URL/headers in receipt/outbox; never launch command/env",
    "transports": ["native-connect-json", "native-connect-proto"],
    "grpc": false,
    "grpc_web": false
  },
  "limits": {
    "body_bytes": 32768,
    "total_timeout_ms": 20000,
    "package_bytes": 33554432,
    "filename_utf8_bytes": 255,
    "abort_reason_utf8_bytes": 512
  },
