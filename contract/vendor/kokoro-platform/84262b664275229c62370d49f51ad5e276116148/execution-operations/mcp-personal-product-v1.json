  "source_delta": {
    "methods": "  rpc CreatePersonalMcpConnector(kokoro.platform.v1.CreatePersonalMcpConnectorRequest) returns (kokoro.platform.v1.CreatePersonalMcpConnectorResponse);\n  rpc UpdatePersonalMcpConnector(kokoro.platform.v1.UpdatePersonalMcpConnectorRequest) returns (kokoro.platform.v1.UpdatePersonalMcpConnectorResponse);\n  rpc SetPersonalMcpConnectorEnabled(kokoro.platform.v1.SetPersonalMcpConnectorEnabledRequest) returns (kokoro.platform.v1.SetPersonalMcpConnectorEnabledResponse);\n  rpc RemovePersonalMcpConnector(kokoro.platform.v1.RemovePersonalMcpConnectorRequest) returns (kokoro.platform.v1.RemovePersonalMcpConnectorResponse);\n  rpc ListPersonalMcpProviders(kokoro.platform.v1.ListPersonalMcpProvidersRequest) returns (kokoro.platform.v1.ListPersonalMcpProvidersResponse);\n  rpc GetPersonalMcpProvider(kokoro.platform.v1.GetPersonalMcpProviderRequest) returns (kokoro.platform.v1.GetPersonalMcpProviderResponse);",
    "fields": "  optional string display_name = 6;\n  optional string description = 7;\n  bool enabled = 8;\n  uint64 state_version = 9;\n  optional string created_at = 10;\n  optional string updated_at = 11;",
    "suffix": "\n\n// Human control plane: BFF workload + current human qualification, not execution proof.\nmessage CreatePersonalMcpConnectorRequest {\n  string request_id = 1;\n  kokoro.common.v1.CommandIdentity command = 2;\n  string provider_key = 3;\n  kokoro.platform.v1.McpConnectorType connector_type = 4;\n  string display_name = 5;\n  string description = 6;\n}\nmessage UpdatePersonalMcpConnectorRequest {\n  string request_id = 1;\n  kokoro.common.v1.CommandIdentity command = 2;\n  kokoro.platform.v1.McpConnectorId connector_id = 3;\n  optional uint64 expected_state_version = 4;\n  string display_name = 5;\n  string description = 6;\n}\nmessage SetPersonalMcpConnectorEnabledRequest {\n  string request_id = 1;\n  kokoro.common.v1.CommandIdentity command = 2;\n  kokoro.platform.v1.McpConnectorId connector_id = 3;\n  optional uint64 expected_state_version = 4;\n  optional bool enabled = 5;\n}\nmessage RemovePersonalMcpConnectorRequest {\n  string request_id = 1;\n  kokoro.common.v1.CommandIdentity command = 2;\n  kokoro.platform.v1.McpConnectorId connector_id = 3;\n  optional uint64 expected_state_version = 4;\n}\nmessage CreatePersonalMcpConnectorResponse {\n  kokoro.platform.v1.PersonalMcpConnector connector = 1;\n}\nmessage ListPersonalMcpProvidersRequest {\n  string request_id = 1;\n  optional string query = 2;\n  optional string directory_type = 3;\n  optional string category_key = 4;\n  kokoro.platform.v1.PersonalMcpPageRequest page = 5;\n}\nmessage GetPersonalMcpProviderRequest {\n  string request_id = 1;\n  string provider_key = 2;\n}\nmessage PersonalMcpProvider {\n  string provider_key = 1;\n  string display_name = 2;\n  optional string description = 3;\n  string directory_type = 4;\n  repeated string category_keys = 5;\n  repeated string example_prompts = 6;\n  optional string author = 7;\n  optional string website = 8;\n  optional string privacy_url = 9;\n  bool enabled = 10;\n  uint64 state_version = 11;\n}\nmessage ListPersonalMcpProvidersResponse {\n  repeated kokoro.platform.v1.PersonalMcpProvider providers = 1;\n  kokoro.common.v1.PageResult page = 2;\n}\nmessage GetPersonalMcpProviderResponse {\n  kokoro.platform.v1.PersonalMcpProvider provider = 1;\n}\n\nmessage UpdatePersonalMcpConnectorResponse {\n  kokoro.platform.v1.PersonalMcpConnector connector = 1;\n}\n\nmessage SetPersonalMcpConnectorEnabledResponse {\n  kokoro.platform.v1.PersonalMcpConnector connector = 1;\n}\n\nmessage RemovePersonalMcpConnectorResponse {\n  kokoro.platform.v1.PersonalMcpConnector connector = 1;\n}\n",
    "http_fragment": ",\n      \"PersonalMcpConnector\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"connector_id\",\n          \"connector_type\",\n          \"provider_key\",\n          \"status\",\n          \"approved_scopes\",\n          \"enabled\",\n          \"state_version\"\n        ],\n        \"properties\": {\n          \"connector_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"maxLength\": 191\n          },\n          \"connector_type\": {\n            \"type\": \"integer\",\n            \"enum\": [1, 2, 3]\n          },\n          \"provider_key\": {\n            \"type\": \"string\",\n            \"pattern\": \"^[a-z0-9][a-z0-9._-]{0,63}$\"\n          },\n          \"status\": {\n            \"type\": \"integer\",\n            \"enum\": [1, 2, 3, 4]\n          },\n          \"approved_scopes\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"display_name\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"maxLength\": 100\n          },\n          \"description\": {\n            \"type\": \"string\",\n            \"maxLength\": 1000\n          },\n          \"enabled\": {\n            \"type\": \"boolean\"\n          },\n          \"state_version\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 2147483647\n          },\n          \"created_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"updated_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          }\n        }\n      },\n      \"PersonalMcpProvider\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"provider_key\",\n          \"display_name\",\n          \"directory_type\",\n          \"category_keys\",\n          \"example_prompts\",\n          \"enabled\",\n          \"state_version\"\n        ],\n        \"properties\": {\n          \"provider_key\": {\n            \"type\": \"string\",\n            \"pattern\": \"^[a-z0-9][a-z0-9._-]{0,63}$\"\n          },\n          \"display_name\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"maxLength\": 100\n          },\n          \"description\": {\n            \"type\": \"string\",\n            \"maxLength\": 1000\n          },\n          \"directory_type\": {\n            \"type\": \"string\",\n            \"enum\": [\"app\", \"data_source\"]\n          },\n          \"category_keys\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"items\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"efficiency\",\n                \"creation\",\n                \"business\",\n                \"development\",\n                \"finance\",\n                \"travel\",\n                \"health\"\n              ]\n            }\n          },\n          \"example_prompts\": {\n            \"type\": \"array\",\n            \"maxItems\": 10,\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1,\n              \"maxLength\": 1000\n            }\n          },\n          \"author\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"maxLength\": 100\n          },\n          \"website\": {\n            \"type\": \"string\",\n            \"format\": \"uri\"\n          },\n          \"privacy_url\": {\n            \"type\": \"string\",\n            \"format\": \"uri\"\n          },\n          \"enabled\": {\n            \"type\": \"boolean\"\n          },\n          \"state_version\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 2147483647\n          }\n        }\n      }"
  },
