          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "category_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "programming",
                "data",
                "automation",
                "business",
                "design",
                "media",
                "content",
                "apps"
              ]
            }
          },
          {
            "name": "source_kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["personal", "official", "third_party"]
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SkillList"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/mcp/servers": {
      "get": {
        "operationId": "listMcpServers",
        "x-kokoro-owner": "kokoro-platform",
        "x-kokoro-visibility": "internal-owner",
        "x-kokoro-stability": "stable",
        "x-kokoro-idempotency": "read-only",
        "x-kokoro-permission": "platform:projection.read",
        "x-kokoro-surface": "mcp-server",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/SubjectId"
          },
          {
            "name": "provider_key",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/McpServerList"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/mcp/connections": {
      "get": {
        "operationId": "listSelfMcpConnections",
        "x-kokoro-owner": "kokoro-platform",
        "x-kokoro-visibility": "internal-owner",
        "x-kokoro-stability": "stable",
        "x-kokoro-idempotency": "read-only",
        "x-kokoro-permission": "platform:projection.read",
        "x-kokoro-surface": "mcp-connection",
        "parameters": [
          {
            "$ref": "#/components/parameters/McpConnectionId"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/SubjectId"
          },
          {
            "name": "provider_key",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            },
            "required": false
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/McpConnectionList"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "List current subject active MCP connections"
      }
    },
    "/v1/self/skills": {
      "get": {
        "operationId": "listSelfManagedSkills",
        "summary": "List the authenticated Product subject own Skills across management states.",
        "description": "Returns only the current subject own exact Skill revisions. Management visibility does not grant installation or execution.",
        "x-kokoro-owner": "kokoro-platform",
        "x-kokoro-visibility": "internal-owner",
        "x-kokoro-stability": "stable",
        "x-kokoro-idempotency": "read-only",
        "x-kokoro-permission": "platform:projection.read",
        "x-kokoro-surface": "skill-source",
        "x-kokoro-total-budget-ms": 10000,
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/SubjectId"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/SelfSkillStatus"
          },
          {
            "name": "source_kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["personal", "official", "third_party"]
            }
          },
          {
            "$ref": "#/components/parameters/SkillQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SelfSkillList"
          },
          "400": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "401": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "403": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "500": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "503": {
            "$ref": "#/components/responses/SelfSkillError"
          }
        }
      }
    },
    "/v1/self/skills/{skill_id}": {
      "get": {
        "operationId": "getSelfManagedSkill",
        "summary": "Read one exact Skill revision owned by the authenticated Product subject.",
        "description": "Returns the current subject own exact Skill in any supported management state. Missing and non-owner Skills are indistinguishable.",
        "x-kokoro-owner": "kokoro-platform",
        "x-kokoro-visibility": "internal-owner",
        "x-kokoro-stability": "stable",
        "x-kokoro-idempotency": "read-only",
        "x-kokoro-permission": "platform:projection.read",
        "x-kokoro-surface": "skill-source",
        "x-kokoro-total-budget-ms": 10000,
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/SubjectId"
          },
          {
            "$ref": "#/components/parameters/SkillId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SelfSkill"
          },
          "400": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "401": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "403": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "404": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "500": {
            "$ref": "#/components/responses/SelfSkillError"
          },
          "503": {
            "$ref": "#/components/responses/SelfSkillError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RequestId": {
        "name": "x-kokoro-request-id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "TenantId": {
        "name": "x-kokoro-tenant-id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": "Optional consistency assertion only; tenant authority is IAM introspection."
      },
      "SubjectId": {
        "name": "x-kokoro-subject",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$"
        },
        "description": "Product Session subject projected by the authenticated kokoro-bff workload after IAM admission; never a browser-supplied tenant identity."
      },
      "SkillQuery": {
        "name": "query",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "SkillTags": {
        "name": "tags",
        "in": "query",
        "required": false,
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "style": "form",
        "explode": true
      },
      "SkillScope": {
        "name": "scope_kind",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "personal",
            "project",
            "organization",
            "session",
            "1",
            "2",
            "3",
            "4"
          ]
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "SkillId": {
        "name": "skill_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
        },
        "description": "Canonical Platform Skill ID, not a source_ref or package asset ID."
      },
      "McpConnectionId": {
        "name": "connection_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
        }
      },
      "SelfSkillStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "disabled",
            "withdrawn",
            "quarantined",
            "discarded"
          ]
        },
        "description": "Optional exact management-state filter; not an execution eligibility assertion."
      }
    },
    "schemas": {
      "Skill": {
        "type": "object",
        "required": [
          "source_ref",
          "name",
          "description",
          "content_hash",
          "scope",
          "revision",
          "enabled",
          "skill_updated_at",
          "example_prompts",
          "category_keys",
          "product"
        ],
        "additionalProperties": false,
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "personal",
              "project",
              "organization",
              "session",
              "unknown"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "enabled": {
            "type": "boolean"
          },
          "installed": {
            "type": "boolean"
          },
          "skill_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "example_prompts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S",
              "x-kokoro-unpaired-surrogates": "reject",
              "not": {
                "pattern": "\\u0000"
              }
            },
            "x-kokoro-total-utf8-bytes": 16384
          },
          "category_keys": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "programming",
                "data",
                "automation",
                "business",
                "design",
                "media",
                "content",
                "apps"
              ]
            }
          },
          "product": {
            "$ref": "#/components/schemas/SkillProductFacts"
          }
        }
      },
      "McpServer": {
        "type": "object",
        "required": [
          "server_id",
          "provider_key",
          "server_identity",
          "transport",
          "declaration_digest",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "server_id": {
            "type": "string"
          },
          "provider_key": {
            "type": "string"
          },
          "server_identity": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": ["stdio", "streamable_http", "sse_compat", "unknown"]
          },
          "declaration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["registered", "disabled", "unknown"]
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "PublishedPersonalSkill": {
        "type": "object",
        "required": [
          "skill_id",
          "source_ref",
          "revision",
          "status",
          "name",
          "summary",
          "tags",
          "skill_updated_at",
          "example_prompts",
          "category_keys",
          "product"
        ],
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "pattern": "^skill:[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "status": {
            "type": "string",
            "enum": ["active"]
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skill_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "example_prompts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S",
              "x-kokoro-unpaired-surrogates": "reject",
              "not": {
                "pattern": "\\u0000"
              }
            },
            "x-kokoro-total-utf8-bytes": 16384
          },
          "category_keys": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
