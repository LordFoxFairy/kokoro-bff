            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "category_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "programming",
                "data",
                "automation",
                "business",
                "design",
                "media",
                "content",
                "apps"
              ]
            }
          },
          {
            "name": "source_kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["personal", "official", "third_party"]
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SkillList"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/skills/catalog": {
      "get": {
        "operationId": "listVisibleSkillCatalog",
        "x-kokoro-owner": "kokoro-platform",
        "x-kokoro-visibility": "internal-owner",
        "x-kokoro-stability": "stable",
        "x-kokoro-idempotency": "read-only",
        "x-kokoro-permission": "platform:projection.read",
        "x-kokoro-surface": "skill-source",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
