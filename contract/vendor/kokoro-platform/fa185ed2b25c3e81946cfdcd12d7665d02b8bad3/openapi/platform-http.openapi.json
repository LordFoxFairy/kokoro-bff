      "McpConnection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "connector_id",
          "server_id",
          "provider_key",
          "transport",
          "status"
        ],
        "properties": {
          "connection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
          },
          "connector_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
          },
          "server_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
