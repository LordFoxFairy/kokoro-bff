            "enum": ["streamable_http"]
          },
          "status": {
            "type": "string",
            "enum": ["active"]
          }
        }
      },
      "SelfManagedSkill": {
        "type": "object",
        "required": [
          "skill_id",
          "source_ref",
          "series_id",
          "revision",
          "name",
          "summary",
          "tags",
          "status",
          "skill_updated_at",
          "example_prompts",
          "category_keys",
          "product"
        ],
        "additionalProperties": false,
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
          },
          "source_ref": {
            "type": "string",
            "pattern": "^skill:[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
          },
          "series_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": ".*\\S.*"
          },
          "summary": {
            "type": "string",
            "maxLength": 65535
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            },
            "maxItems": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "disabled",
              "withdrawn",
              "quarantined",
              "discarded"
            ]
          },
          "skill_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "example_prompts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S",
              "x-kokoro-unpaired-surrogates": "reject",
              "not": {
                "pattern": "\\u0000"
              }
            },
            "x-kokoro-total-utf8-bytes": 16384
          },
          "category_keys": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "programming",
                "data",
                "automation",
                "business",
                "design",
                "media",
                "content",
                "apps"
              ]
            }
          },
          "product": {
            "$ref": "#/components/schemas/SkillProductFacts"
          }
        }
      },
