{
  "openapi": "3.1.0",
  "info": {
    "title": "Kokoro Business API",
    "version": "29.3.0",
    "description": "Kokoro BFF 面向 Web 的业务契约；阶段 1 仅通过 PostgreSQL + Redis 及显式 HTTP upstream/adapter 契约协作，不新增 MySQL/Mongo 依赖。",
    "license": {
      "name": "Proprietary Kokoro contract",
      "url": "https://kokoro.invalid/license"
    }
  },
  "x-kokoro-projection": {
    "profile": "session-share-metadata-browser",
    "version": "1.0.0",
    "source": {
      "path": "contract/openapi/v1/openapi.yaml",
      "version": "29.3.0",
      "sha256": "4f27adbea9a63c36d8b11e95c9dde342a6e8d662cab77cb42091384f3b17e333"
    },
    "operation_id": "getSessionShareMetadata"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4300",
      "description": "Local mock BFF"
    },
    {
      "url": "https://bff.kokoro.invalid",
      "description": "Production placeholder"
    }
  ],
  "security": [
    {
      "serviceHeader": [],
      "internalSecret": [],
      "userBearer": []
    }
  ],
  "tags": [
    {
      "name": "Chat",
      "description": "Asynchronous sessions, messages, event streams, and run controls."
    }
  ],
  "paths": {
    "/v1/sessions/{id}/share": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "get": {
        "tags": [
          "Chat"
        ],
        "operationId": "getSessionShareMetadata",
        "x-kokoro-owner": "kokoro-bff",
        "x-kokoro-visibility": "public",
        "x-kokoro-stability": "beta",
        "x-kokoro-idempotency": "none",
        "x-kokoro-permission": "chat.read",
        "summary": "Read the current owned session share",
        "description": "Read-only owner metadata. An accessible unshared, revoked or expired session returns share null; inaccessible sessions return the same not-found result. Never creates a share or updates expiry state.",
        "parameters": [
          {
            "$ref": "#/components/parameters/DirectScopeQuery"
          },
          {
            "$ref": "#/components/parameters/ProjectRefQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Current active share or an accessible unshared session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionShareMetadataResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/ServiceAuthFailed"
          },
          "403": {
            "$ref": "#/components/responses/ServiceAuthFailed"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "description": "IAM session admission is rate limited",
            "headers": {
              "Retry-After": {
                "description": "Bounded delay in seconds before retrying admission",
                "schema": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,4}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SessionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Opaque chat session identifier.",
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "example": "session_kokoro"
      },
      "DirectScopeQuery": {
        "name": "scope",
        "in": "query",
        "required": false,
        "description": "On the Conversation collection, omitted or empty keeps the admitted owner's full visible set while direct restricts results to project_ref IS NULL. On resource routes it does not alter the existing project-bound authorization. It never overrides the admitted tenant and subject.",
        "schema": {
          "type": "string",
          "enum": [
            "",
            "direct"
          ]
        },
        "example": "direct"
      },
      "ProjectRefQuery": {
        "name": "project_ref",
        "in": "query",
        "required": false,
        "description": "Filter the Conversation collection to an owned project reference. A nonempty value cannot be combined with scope=direct on GET /v1/sessions; resource routes retain their existing project-bound authorization.",
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "example": "project_kokoro"
      }
    },
    "schemas": {
      "SessionShareMetadataResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "share"
            ],
            "properties": {
              "share": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SessionShareMetadata"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/RequestMeta"
          }
        }
      },
      "SessionShareMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "share_id",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "share_id": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "RequestMeta": {
        "type": "object",
        "required": [
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "example": {
          "request_id": "req_01JASYNC000000000000000000"
        }
      },
      "RequestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "description": "Request correlation identifier echoed by every v1 envelope.",
        "example": "req_01JASYNC000000000000000000"
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "meta": {
            "$ref": "#/components/schemas/RequestMeta"
          }
        },
        "example": {
          "error": {
            "code": "session_not_found",
            "message": "Session was not found"
          },
          "meta": {
            "request_id": "req_01JASYNC000000000000000000"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "example": "session_not_found"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "example": "Session was not found"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "ServiceAuthFailed": {
        "description": "Service or user-session authentication failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A required BFF fact store or owner source is not configured",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "serviceHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kokoro-service"
      },
      "internalSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-kokoro-internal-secret"
      },
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-session-token"
      }
    }
  }
}
