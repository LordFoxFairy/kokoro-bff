  "x-kokoro-auth-session-policy": {
    "profile": "browser-auth-session",
    "version": "1.0.0",
    "path": "/browser/v1/auth/session",
    "operation_id": "getBrowserAuthSession",
    "refresh_default": true,
    "refresh_false": {
      "disableCookieCache": true,
      "disableRefresh": true
    },
    "automatic_retries": false,
    "errors": [
      {
        "status": 400,
        "code": "auth_session_request_invalid",
        "message": "Authentication status request is invalid",
        "retryable": false
      },
      {
        "status": 403,
        "code": "service_auth_failed",
        "message": "Trusted browser service is required",
        "retryable": false
      },
      {
        "status": 403,
        "code": "product_tenant_forbidden",
        "message": "Product tenant is not permitted",
        "retryable": false
      },
      {
        "status": 403,
        "code": "session_forbidden",
        "message": "Current Product qualification is required",
        "retryable": false
      },
      {
        "status": 429,
        "code": "session_rate_limited",
        "message": "Authentication service is rate limited",
        "retryable": true
      },
      {
        "status": 503,
        "code": "product_tenant_not_configured",
        "message": "Product tenant is not configured",
        "retryable": true
      },
      {
        "status": 503,
        "code": "iam_admission_unavailable",
        "message": "Authentication service is unavailable",
        "retryable": true
      }
    ]
  },
