NODE_ENV=production
KOKORO_BFF_HOST=0.0.0.0
KOKORO_BFF_PORT=4300
KOKORO_BFF_MODE=live
KOKORO_DOMAIN=app.example.com
KOKORO_TENANT_ID=CHANGE_ME
KOKORO_BFF_SHARED_SECRET=CHANGE_ME
KOKORO_INTERNAL_SECRET_BFF=CHANGE_ME
KOKORO_SYSTEM_BASE_URL=http://kokoro-system:4240
KOKORO_MODEL_BASE_URL=http://kokoro-model:4221
KOKORO_CAPABILITY_BASE_URL=http://kokoro-capability:8086
KOKORO_STORAGE_BASE_URL=http://kokoro-storage:8085
KOKORO_SCHEDULER_BASE_URL=http://kokoro-scheduler:4252
KOKORO_SCHEDULER_SERVICE_TOKEN=CHANGE_ME
KOKORO_SCHEDULER_TARGET_URL=http://kokoro-bff:4300/internal/bff/scheduled-tasks/dispatch
KOKORO_AGENT_BASE_URL=http://kokoro-agent:4401
KOKORO_BILLING_BASE_URL=http://kokoro-billing:4245
KOKORO_BFF_POSTGRES_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/kokoro
