KOKORO_SCHEDULER_BASE_URL=http://kokoro-scheduler:4252
KOKORO_SCHEDULER_SERVICE_TOKEN=CHANGE_ME
KOKORO_SCHEDULER_TARGET_URL=http://kokoro-bff:4300/internal/bff/scheduled-tasks/dispatch
KOKORO_AGENT_BASE_URL=http://kokoro-agent:4401
KOKORO_AGENT_ENABLED=true
KOKORO_BILLING_BASE_URL=http://kokoro-billing:4245
KOKORO_MUSIC_BASE_URL=http://kokoro-music:4410
KOKORO_BFF_POSTGRES_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/kokoro
