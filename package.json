{
  "name": "@kokoro/bff",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:setup": "pnpm build && node dist/database/setup.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contract:lint": "redocly lint docs/api/v1/openapi.yaml",
    "test": "pnpm build && node --test test/architecture.test.ts test/bff.test.ts test/config.test.ts test/mori.test.ts test/scheduler.test.ts test/upstream.test.ts",
    "test:integration": "pnpm build && node --test test/business-store.integration.mjs",
    "check": "pnpm lint && pnpm contract:lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@redocly/cli": "2.46.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "pg": "^8.23.0",
    "redis": "^5.12.1"
  }
}
