NODE_ENV=development
KOKORO_BFF_HOST=127.0.0.1
KOKORO_BFF_PORT=4300
KOKORO_BFF_MODE=live
KOKORO_DOMAIN=dev.kokoro.localhost
KOKORO_TENANT_ID=tenant_local

# Server-to-server caller authentication. Keep this value server-only.
KOKORO_BFF_SHARED_SECRET=local-web-bff-secret

# Only used when KOKORO_BFF_MODE=live. Values name owner services, not
# browser-facing domains. Leave an optional owner unset until its adapter is ready.
# KOKORO_SYSTEM_BASE_URL=http://127.0.0.1:4240
# KOKORO_MODEL_BASE_URL=http://127.0.0.1:4221
# KOKORO_CAPABILITY_BASE_URL=http://127.0.0.1:8086
# KOKORO_STORAGE_BASE_URL=http://127.0.0.1:8085
# KOKORO_SCHEDULER_BASE_URL=http://127.0.0.1:4252
# KOKORO_SCHEDULER_SERVICE_TOKEN=local-scheduler-service-token
# KOKORO_SCHEDULER_TARGET_URL=http://127.0.0.1:4300/internal/bff/scheduled-tasks/dispatch
# KOKORO_AGENT_BASE_URL=http://127.0.0.1:4401
# KOKORO_AGENT_ENABLED=true
# KOKORO_BILLING_BASE_URL=http://127.0.0.1:4245
# KOKORO_MUSIC_BASE_URL=http://127.0.0.1:4410
# KOKORO_INTERNAL_SECRET_BFF=local-bff-upstream-secret
KOKORO_BFF_POSTGRES_URL=postgresql://kokoro:kokoro@127.0.0.1:55433/kokoro_worker_bff
KOKORO_BFF_REDIS_URL=redis://127.0.0.1:56380/8
KOKORO_AGUI_LEDGER_POLL_BASE_DELAY_MS=1000
KOKORO_AGUI_LEDGER_POLL_MAX_DELAY_MS=8000
KOKORO_AGUI_LEDGER_POLL_JITTER_PERCENT=20
KOKORO_AGUI_PROJECTOR_MAX_CONSUMERS_PER_CYCLE=32
KOKORO_AGUI_PROJECTOR_SOURCE_PAGE_SIZE=256
KOKORO_AGUI_PROJECTOR_MAX_PAGES_PER_CONSUMER=8
KOKORO_AGUI_PROJECTOR_SOURCE_MAX_ATTEMPTS=3
KOKORO_AGUI_PROJECTOR_LEASE_DURATION_MS=15000
KOKORO_AGUI_PROJECTOR_LEASE_SETTLEMENT_RESERVE_MS=500
KOKORO_AGUI_PROJECTOR_POLL_INTERVAL_MS=1000
KOKORO_AGUI_PROJECTOR_ERROR_BACKOFF_MS=5000
KOKORO_AGUI_PROJECTOR_ERROR_BACKOFF_MAX_MS=300000
KOKORO_AGUI_PROJECTOR_ERROR_BACKOFF_JITTER_PERCENT=20
KOKORO_AGUI_RETENTION_MS=604800000
KOKORO_AGUI_GC_INTERVAL_MS=900000
KOKORO_AGUI_GC_BATCH_SIZE=100
KOKORO_AGUI_CURSOR_TOMBSTONE_RETENTION_MS=2592000000
