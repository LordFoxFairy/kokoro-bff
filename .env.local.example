NODE_ENV=development
KOKORO_BFF_HOST=127.0.0.1
KOKORO_BFF_PORT=4300
KOKORO_BFF_MODE=mock
KOKORO_DOMAIN=dev.kokoro.localhost

# Server-to-server caller authentication. Keep this value server-only.
KOKORO_BFF_SHARED_SECRET=local-web-bff-secret

# Only used when KOKORO_BFF_MODE=live. Chat/Run uses the Agent business adapter.
# KOKORO_PROJECTS_BASE_URL=http://127.0.0.1:4240
# KOKORO_HUB_BASE_URL=http://127.0.0.1:8086
# KOKORO_SKILLS_BASE_URL=http://127.0.0.1:8086
# Agent 当前只有 Redis worker，没有 HTTP upstream；Chat/Agent live 接线待 HTTP adapter v1。
# KOKORO_SCHEDULED_BASE_URL=http://127.0.0.1:4252
# KOKORO_LIBRARY_BASE_URL=http://127.0.0.1:8085
# KOKORO_BILLING_BASE_URL=http://127.0.0.1:4245
# KOKORO_INTERNAL_SECRET_BFF=local-bff-upstream-secret
