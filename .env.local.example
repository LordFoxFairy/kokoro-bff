NODE_ENV=development
KOKORO_BFF_HOST=127.0.0.1
KOKORO_BFF_PORT=4300
KOKORO_BFF_MODE=mock
KOKORO_DOMAIN=dev.kokoro.localhost

# Server-to-server caller authentication. Keep this value server-only.
KOKORO_BFF_SHARED_SECRET=local-web-bff-secret

# Only used when KOKORO_BFF_MODE=live. Chat/SSE does not pass through this service.
# KOKORO_PROJECTS_BASE_URL=http://127.0.0.1:4251
# KOKORO_HUB_BASE_URL=http://127.0.0.1:4251
# KOKORO_AGENT_BASE_URL=http://127.0.0.1:4260
# KOKORO_SCHEDULED_BASE_URL=http://127.0.0.1:4251
# KOKORO_LIBRARY_BASE_URL=http://127.0.0.1:4251
# KOKORO_BILLING_BASE_URL=http://127.0.0.1:4245
# KOKORO_INTERNAL_SECRET_BFF=local-bff-upstream-secret
